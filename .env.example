# APPLICATION SETTINGS
APP_NAME="portal-mx-api"
APP_PORT=3000
APP_ENV=local
APP_CORS_ORIGIN=*
APP_CORS_ALLOWED_HEADERS=Content-Type,Authorization,Accept
APP_CORS_ALLOWED_METHODS=POST,PUT,DELETE,GET,PATCH,OPTIONS

# DATABASE (MariaDB)
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_PORT=3306
DB_DATABASE=
DB_TYPE=mariadb
DB_POOL_SIZE=50

# JWT
JWT_SECRET_KEY=your_jwt_secret_key
JWT_EXPIRES_IN=1d
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=

# SWAGGER (dejar vacío para deshabilitar protección)
SWAGGER_USER=admin
SWAGGER_PASSWORD=

# MAIL
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=
MAIL_SECURE=false

# SEEDERS (true para ejecutar al iniciar)
RUN_SEEDERS=false
